[Unit]
Description=readsb ADS-B decoder
Documentation=https://github.com/wiedehopf/readsb
After=network.target
Conflicts=readsb.service dump1090-fa.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=readsb
Group=plugdev
EnvironmentFile=/etc/default/readsb-adsb
RuntimeDirectory=readsb
RuntimeDirectoryMode=0755
ExecStart=/usr/local/lib/adsb-vhf/start-readsb.sh
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/readsb

[Install]
WantedBy=multi-user.target

# Installed as /etc/adsb-vhf/acarsdec.env. No Icecast passwords.
# Frequencies must fit in one RTL-SDR tuner (~2.4 MHz). Europe/POA defaults:
ACARS_FREQUENCIES=131.525 131.550 131.725 131.825
ACARS_UDP_HOST=127.0.0.1
ACARS_UDP_PORT=5550
# rtl gain in tenths of a dB (400 = 40 dB). acarsdec -g.
ACARS_GAIN=400

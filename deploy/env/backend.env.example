# Installed as /etc/adsb-vhf/backend.env. Set station coordinates and channels.
# Production bind: BACKEND_HOST / BACKEND_PORT (uvicorn ExecStart).
# Local .env AIRMON_HOST / AIRMON_PORT are for developer uvicorn only.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
# Required before binding beyond loopback. Send as header X-Admin-Token.
# AIRMON_ADMIN_TOKEN=
AIRMON_STATION_NAME="Тюмень/Рощино"
AIRMON_STATION_LAT=57.1896
AIRMON_STATION_LON=65.3243
AIRMON_ADSB_SOURCE=json
AIRMON_READSB_JSON_PATH=/run/readsb/aircraft.json
# SBS date/time fields are interpreted in this IANA timezone, then stored as UTC.
AIRMON_SBS_TIMEZONE=UTC
AIRMON_RAW_HOST=127.0.0.1
AIRMON_RAW_PORT=30002
AIRMON_RAW_LOG_SIZE=1000
AIRMON_LAYERS_DIR=/opt/adsb-vhf/data/layers
AIRMON_COVERAGE_PATH=/var/lib/adsb-vhf/coverage-rose.json
AIRMON_AIRCRAFT_TYPES_PATH=/var/lib/adsb-vhf/aircraft-types.json
AIRMON_WEBSOCKET_HEARTBEAT_S=10
AIRMON_RADIO_AUTO_DETECT=true
AIRMON_RADIO_MIN_RTL_RECEIVERS=2
AIRMON_RADIO_RECEIVER_SERIAL=0118
AIRMON_RADIO_CHANNELS_JSON='[{"id":"tower","name":"Вышка","frequency_mhz":118.1,"stream_url":"http://127.0.0.1:8000/vhf-118100.mp3"},{"id":"ground","name":"Земля","frequency_mhz":118.5,"stream_url":"http://127.0.0.1:8000/vhf-118500.mp3"},{"id":"approach","name":"Подход","frequency_mhz":119.1,"stream_url":"http://127.0.0.1:8000/vhf-119100.mp3"}]'

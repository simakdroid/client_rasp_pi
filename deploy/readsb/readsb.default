# systemd EnvironmentFile syntax only: KEY=value. This file is not sourced by a
# shell. start-readsb.sh builds argv with set -f and unquoted option groups.
# Do not put eval, source, or shell expansions here. Own the file as root.
# EEPROM serials live in /etc/adsb-vhf/sdr.env (loaded after this file).
# Installed once as /etc/default/readsb-adsb. deploy/install.sh does not
# overwrite an existing file, so --lat/--lon survive git pull + reinstall.
# With one RTL-SDR the launcher uses index 0. With two or more it selects
# ADSB_PREFERRED_SERIAL. Never use unstable enumeration indexes as --device.
RECEIVER_OPTIONS="--gain -10"
DECODER_OPTIONS="--max-range 450 --fix --lat 57.1896 --lon 65.3243"
NET_OPTIONS="--net --net-heartbeat 60 --net-ro-size 1200 --net-ro-interval 0.05 --net-ri-port 30001 --net-ro-port 30002 --net-sbs-port 30003 --net-bi-port 30004,30104 --net-bo-port 30005"
JSON_OPTIONS="--write-json /run/readsb --write-json-every 1"

# RTL2832U devices are opened through libusb. EEPROM serial is used only to
# assign roles when two dongles are present. A blank serial must still get
# plugdev access, otherwise a single unprogrammed stick cannot be opened.
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", MODE="0660", GROUP="plugdev", TAG+="systemd"
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", MODE="0660", GROUP="plugdev", TAG+="systemd"
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{serial}=="1090", ENV{ADSB_VHF_ROLE}="adsb-1090", ENV{SYSTEMD_ALIAS}="/sys/subsystem/usb/adsb-1090", ENV{SYSTEMD_WANTS}+="readsb-adsb.service"
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{serial}=="0118", ENV{ADSB_VHF_ROLE}="vhf-0118", ENV{SYSTEMD_ALIAS}="/sys/subsystem/usb/vhf-0118", ENV{SYSTEMD_WANTS}+="readsb-adsb.service rtl-airband.service"

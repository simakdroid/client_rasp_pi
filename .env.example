# Backend is intentionally bound to localhost for kiosk use.
# Production bind address is BACKEND_HOST / BACKEND_PORT in /etc/adsb-vhf/backend.env.
AIRMON_HOST=127.0.0.1
AIRMON_PORT=8080
# Set before exposing the backend on LAN. The token is sent as X-Admin-Token
# and must not be placed in public JavaScript.
# AIRMON_ADMIN_TOKEN=
AIRMON_STATION_NAME=Тюмень/Рощино
AIRMON_STATION_LAT=57.1896
AIRMON_STATION_LON=65.3243

# json: poll readsb aircraft.json; sbs: connect to TCP port 30003.
AIRMON_ADSB_SOURCE=json
AIRMON_READSB_JSON_PATH=/run/readsb/aircraft.json
AIRMON_SBS_HOST=127.0.0.1
AIRMON_SBS_PORT=30003
# SBS date/time fields are interpreted in this IANA timezone, then stored as UTC.
AIRMON_SBS_TIMEZONE=UTC
AIRMON_RAW_HOST=127.0.0.1
AIRMON_RAW_PORT=30002
AIRMON_RAW_LOG_SIZE=1000
AIRMON_ADSB_POLL_INTERVAL_S=0.75
AIRMON_AIRCRAFT_TTL_S=60
AIRMON_WEBSOCKET_HEARTBEAT_S=10

AIRMON_LAYERS_DIR=/opt/adsb-vhf/data/layers
# Local uvicorn uses AIRMON_HOST / AIRMON_PORT. Production bind is
# BACKEND_HOST / BACKEND_PORT in /etc/adsb-vhf/backend.env.
# Coverage and type catalog must be writable (atomic JSON temp files).
AIRMON_COVERAGE_PATH=/var/lib/adsb-vhf/coverage-rose.json
AIRMON_AIRCRAFT_TYPES_PATH=/var/lib/adsb-vhf/aircraft-types.json
# Set a licensed tile URL here if OpenFlightMaps is required.
AIRMON_OFM_URL=

# rtl_airband/Icecast mounts. Keep Icecast source passwords outside this file.
# Channel list must match deploy/radio-channels.json and rtl_airband.conf.in.
# Do not mix 125.8 MHz with 118.x on one 2.56 MHz stick.
AIRMON_RADIO_AUTO_DETECT=true
AIRMON_RADIO_MIN_RTL_RECEIVERS=2
AIRMON_RADIO_RECEIVER_SERIAL=0118
AIRMON_RADIO_CHANNELS_JSON=[{"id":"tower","name":"Вышка","frequency_mhz":118.1,"stream_url":"http://127.0.0.1:8000/vhf-118100.mp3"},{"id":"ground","name":"Земля","frequency_mhz":118.5,"stream_url":"http://127.0.0.1:8000/vhf-118500.mp3"},{"id":"approach","name":"Подход","frequency_mhz":119.1,"stream_url":"http://127.0.0.1:8000/vhf-119100.mp3"}]

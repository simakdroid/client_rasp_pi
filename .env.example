# Backend is intentionally bound to localhost for kiosk use.
AIRMON_HOST=127.0.0.1
AIRMON_PORT=8080
AIRMON_STATION_NAME=Базовая станция
AIRMON_STATION_LAT=55.7558
AIRMON_STATION_LON=37.6173

# json: poll readsb aircraft.json; sbs: connect to TCP port 30003.
AIRMON_ADSB_SOURCE=json
AIRMON_READSB_JSON_PATH=/run/readsb/aircraft.json
AIRMON_SBS_HOST=127.0.0.1
AIRMON_SBS_PORT=30003
AIRMON_RAW_HOST=127.0.0.1
AIRMON_RAW_PORT=30002
AIRMON_RAW_LOG_SIZE=1000
AIRMON_ADSB_POLL_INTERVAL_S=0.75
AIRMON_AIRCRAFT_TTL_S=60

AIRMON_LAYERS_DIR=/opt/air-monitor/data/layers
# Set a licensed tile URL here if OpenFlightMaps is required.
AIRMON_OFM_URL=

# rtl_airband/Icecast mounts. Keep Icecast source passwords outside this file.
AIRMON_RADIO_AUTO_DETECT=true
AIRMON_RADIO_MIN_RTL_RECEIVERS=2
AIRMON_RADIO_RECEIVER_SERIAL=0118
AIRMON_RADIO_CHANNELS_JSON=[{"id":"tower","name":"Вышка","frequency_mhz":118.1,"stream_url":"http://127.0.0.1:8000/tower"},{"id":"approach","name":"Подход","frequency_mhz":125.8,"stream_url":"http://127.0.0.1:8000/approach"}]
